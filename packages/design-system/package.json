{
  "name": "@heurix/design-system",
  "version": "0.1.0",
  "description": "Heurix design system — React components, OKLCH semantic tokens, dark/light theming.",
  "keywords": [
    "design-system",
    "react",
    "ui",
    "components",
    "tokens",
    "oklch",
    "tailwind-alternative",
    "headless-ui",
    "heurix"
  ],
  "license": "MIT",
  "author": "Jordan Goulart",
  "homepage": "https://heurix-design-system-design-system.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jordangoulart/heurix-design-system.git",
    "directory": "packages/design-system"
  },
  "bugs": {
    "url": "https://github.com/jordangoulart/heurix-design-system/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./src/tokens/tokens.css",
    "./reset.css": "./src/tokens/reset.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/tokens",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-themes": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.0",
    "axe-core": "^4.9.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.0.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
